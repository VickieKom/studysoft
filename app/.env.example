# The Makefile sets these for the local stand; this file documents them.
DATABASE_URL=postgres://studysoft:studysoft@127.0.0.1:54329/studysoft
# At least 32 characters. Generate one per environment: openssl rand -base64 32
AUTH_SECRET=
# Public address of the application, used for cookies and origin checks.
APP_URL=http://localhost:3000
# Shown by /api/healthz; set by the build. Required: the app refuses to start without it.
BUILD_SHA=
